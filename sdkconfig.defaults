CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=y
CONFIG_LOG_DEFAULT_LEVEL_ERROR=y
CONFIG_SMART_FLASH_MODEL_WITH_APP=y
CONFIG_SMART_ENABLE_HTTP_DEBUG_API=n
CONFIG_SMART_HTTP_DEBUG_ENABLE_SERVO_ENDPOINTS=n
# Reduce code size further for 4MB flash constraints.
# Disable dynamic log level control and error-name lookup tables.
CONFIG_LOG_DYNAMIC_LEVEL_CONTROL=n
CONFIG_ESP_ERR_TO_NAME_LOOKUP=n
