# Path to ESP-IDF project root (where CMakeLists.txt lives)
ESP_PROJECT_DIR=.

# Serial port
ESP_PORT=COM3

# Baud rate for flashing / monitor
ESP_BAUD=115200

# Optional explicit path to idf.py
# Leave empty if idf.py is already available in PATH
IDF_PY=

# Optional target, e.g. esp32, esp32s3
ESP_TARGET=esp32

# Optional extra build directory
ESP_BUILD_DIR=

# Optional environment variables if you want to force IDF paths manually
IDF_PATH=
IDF_TOOLS_PATH=